{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AndRainWindow Publisher",
  "version": "0.1.0",
  "identifier": "com.andrainwindow.publisher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AndRainWindow Publisher",
        "width": 1100,
        "height": 720,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Desktop controller for AndRainWindow Publisher"
  }
}
