---
const today = new Date();
---

<footer class="site-footer">

	<p>
		© {today.getFullYear()} AndRainWindow
	</p>

</footer>

<style>

	.site-footer {
		position: relative;
		z-index: 2;

		margin: 0;

		padding:
			28px 20px
			36px;

		text-align: center;

		background: transparent;

		color:
			rgba(255,255,255,0.62);

		font-size: 0.88rem;

		font-family:
			"Noto Serif SC",
			serif;
	}


	.site-footer p {
		margin: 0;
	}

</style>