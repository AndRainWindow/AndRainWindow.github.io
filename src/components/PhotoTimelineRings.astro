---
import { photoDayId } from '../data/photo-timeline.mjs';

const { timeline = [] } = Astro.props;
const days = timeline.flatMap(year => year.months.flatMap(month => month.days));
const first = days[0];
const firstYear = first?.day.slice(0, 4) || '';
const yearDays = days.filter(day => day.day.slice(0, 4) === firstYear);
---

<aside class="timeline-rings" aria-label="摄影时间导航" data-timeline>
  <div class="date-dial" style={`--year-progress: ${timeline.length ? 100 / timeline.length : 0}; --day-progress: ${yearDays.length ? 100 / yearDays.length : 0}`}>
    <svg class="dial-rings" viewBox="0 0 200 200" fill="none" aria-hidden="true">
      <circle class="ring-track" cx="100" cy="100" r="92" />
      <circle class="ring-track" cx="100" cy="100" r="77" />
      <circle class="ring-progress ring-year" cx="100" cy="100" r="92" pathLength="100" />
      <circle class="ring-progress ring-day" cx="100" cy="100" r="77" pathLength="100" />
      {Array.from({ length: 12 }, (_, index) => (
        <line class="dial-tick" x1="100" y1="2" x2="100" y2="5" transform={`rotate(${index * 30} 100 100)`} />
      ))}
    </svg>
    <div class="dial-face">
      <label class="dial-field dial-year">
        <span class="sr-only">选择年份</span>
        <select data-timeline-year disabled={true}>
          {timeline.map(({ year }) => <option value={year || 'undated'}>{year || '日期未知'}</option>)}
        </select>
      </label>
      <label class="dial-field dial-date">
        <span class="sr-only">选择月日</span>
        <select data-timeline-day disabled={true}>
          {yearDays.map(({ day }) => <option value={day || 'undated'}>{day ? day.slice(5).replace('-', '.') : '—'}</option>)}
        </select>
      </label>
      <span class="dial-position" data-timeline-position>{first ? `01 / ${String(first.items.length).padStart(2, '0')}` : '暂无照片'}</span>
    </div>
  </div>

  <div class="date-archive">
    <p class="archive-label">光阴索引 <span>{days.length} 天</span></p>
    <nav class="archive-scroll" aria-label="按拍摄日期浏览">
      {timeline.map(({ year, months }) => (
        <div class="archive-year">
          <h2>{year || '未记录日期'}</h2>
          {months.flatMap(month => month.days).map(({ day, items }) => (
            <a
              class:list={['timeline-link', { active: day === first?.day }]}
              href={`#${photoDayId(day)}`}
              data-day={day || 'undated'}
              data-year={year || 'undated'}
              data-count={items.length}
              aria-current={day === first?.day ? 'date' : undefined}
              aria-label={`${day || '未记录日期'}，${items.length} 张照片`}
            >
              <span>{day ? day.slice(5).replace('-', '.') : '日期未知'}</span>
              <span class="day-count">{String(items.length).padStart(2, '0')}</span>
            </a>
          ))}
        </div>
      ))}
    </nav>
  </div>
</aside>

<style>
  .timeline-rings {
    position: sticky;
    top: 60px;
    min-width: 0;
    color: rgba(255, 255, 255, .8);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .date-dial { position: relative; width: 100%; aspect-ratio: 1; }
  .dial-rings { display: block; width: 100%; height: 100%; overflow: visible; }
  .ring-track { stroke: rgba(255, 255, 255, .16); stroke-width: .7; }
  .ring-progress {
    stroke: rgba(255, 255, 255, .76);
    stroke-width: 1.4;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dasharray .45s ease;
  }
  .ring-year { stroke-dasharray: var(--year-progress) 100; }
  .ring-day { stroke-dasharray: var(--day-progress) 100; stroke: #c8d5d7; stroke-width: 2; }
  .dial-tick { stroke: rgba(255, 255, 255, .36); stroke-width: 1; }
  .dial-face {
    position: absolute;
    inset: 24%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  .dial-field { display: block; max-width: 100%; }
  .dial-field select {
    display: block;
    width: 100%;
    appearance: none;
    border: 0;
    border-radius: 4px;
    padding: 3px 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: center;
    text-align-last: center;
    cursor: pointer;
  }
  .dial-field option { background: #202c33; color: white; font-size: 14px; }
  .dial-field select:disabled { opacity: 1; cursor: default; }
  .dial-field select:hover { background: rgba(255, 255, 255, .08); }
  .dial-field select:focus-visible, .timeline-link:focus-visible { outline: 1px solid #fff; outline-offset: 3px; }
  .dial-year { font-size: 14px; letter-spacing: 3px; color: rgba(255, 255, 255, .7); }
  .dial-date { font-size: clamp(22px, 2.2vw, 30px); font-weight: 300; line-height: 1.3; color: #fff; }
  .dial-position { margin-top: 5px; font-size: 10px; letter-spacing: 2px; color: rgba(255, 255, 255, .5); }
  .date-archive { margin: 22px 14px 0; }
  .archive-label { display: flex; justify-content: space-between; margin: 0 0 18px; font-size: 10px; letter-spacing: 2px; color: rgba(255, 255, 255, .55); }
  .archive-label span { letter-spacing: 0; }
  .archive-scroll { max-height: max(140px, calc(100dvh - 360px)); overflow-y: auto; scrollbar-width: thin; scrollbar-color: #ffffff30 transparent; padding: 4px; margin: -4px; }
  .archive-year + .archive-year { margin-top: 18px; }
  .archive-year h2 { margin: 0 0 7px; font-size: 11px; font-weight: 400; letter-spacing: 2px; color: rgba(255, 255, 255, .42); }
  .timeline-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    box-sizing: border-box;
    padding: 6px 10px;
    border-left: 1px solid rgba(255, 255, 255, .14);
    color: rgba(255, 255, 255, .6);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 1px;
    transition: color .2s, background .2s;
  }
  .timeline-link:hover, .timeline-link.active { color: #fff; background: rgba(255, 255, 255, .06); }
  .timeline-link.active { border-left-color: #dce8e9; }
  .day-count { font-size: 10px; opacity: .5; }
  @media (max-width: 1050px) {
    .dial-year { font-size: 12px; }
    .dial-position { font-size: 9px; letter-spacing: 1px; }
    .date-archive { margin-inline: 4px; }
  }
  @media (max-width: 760px) {
    .timeline-rings { position: static; display: grid; grid-template-columns: 126px minmax(0, 1fr); align-items: center; gap: 24px; margin-bottom: 42px; }
    .date-archive { margin: 0; }
    .archive-label { margin-bottom: 8px; }
    .archive-scroll { max-height: 140px; }
    .archive-year h2 { margin-bottom: 4px; }
    .timeline-link { min-height: 44px; }
    .dial-face { inset: 20%; }
    .dial-date { font-size: 23px; }
    .dial-year { font-size: 11px; }
    .dial-position { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-progress, .timeline-link { transition: none; }
  }
</style>
