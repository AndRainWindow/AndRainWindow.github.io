---
import photosData from '../data/photos.json';
import { displayPhotos } from '../data/photo-view.mjs';

// 每组照片只取封面（组内第一张）作为一个时间轴节点
type DisplayPhoto = {
	id: string;
	groupId?: string;
	day: string;
	title?: string;
	location?: string;
	image: string;
	alt: string;
};

const photos: DisplayPhoto[] = displayPhotos(photosData);
const seen = new Set<string>();
const groups = photos.filter((photo: DisplayPhoto) => {
	const key = photo.groupId || photo.id;
	if (seen.has(key)) return false;
	seen.add(key);
	return true;
});
const covers = groups.slice(0, 8);
---

<section class="recent-photos">

	<div class="section-heading">
		<h2>Photography</h2>
		<p>最近记录下的一些东西。</p>
		<span class="scroll-hint">左右滑动来查看</span>
	</div>

	<div
		class="photo-timeline"
		data-photo-timeline
		tabindex="0"
		aria-label="摄影作品时间轴"
	>

		<div class="timeline-line" aria-hidden="true"></div>

		<div class="timeline-track">

			{covers.map((photo: DisplayPhoto, index: number) => (

				<a
					class="timeline-item"
					href="/photos/"
					aria-label={`查看作品：${photo.alt}`}
				>

					<div class="timeline-date">
						<span class="timeline-dot"></span>
						<time datetime={photo.day}>
							{photo.day.slice(0, 10)}
						</time>
					</div>

					<div class="photo-card">

						<img
							src={photo.image}
							alt={photo.alt}
							loading={index === 0 ? 'eager' : 'lazy'}
						/>

						<div class="photo-gradient"></div>

						<div class="photo-caption">
							{photo.title && <h3>{photo.title}</h3>}
							<p>
								{photo.day.slice(0, 10)}
								{photo.location && ` · ${photo.location}`}
							</p>
						</div>

					</div>

				</a>

			))}

		</div>

	</div>


	<a
		class="photo-more"
		href="/photos/"
	>

	</a>

</section>


<style>

	.recent-photos {
		position: relative;

		max-width: 1200px;

		margin: 0 auto;

		padding:
			140px 30px;
	}


	.section-heading h2 {
		margin:
			0 0 60px;

		text-align: center;

		font-size: 2.5rem;
		font-weight: 300;

		color: white;
	}

	.section-heading p {
		margin:
			0 0 60px;

		text-align: center;
		margin-top: 14px;
		font-size: 0.95rem;
		color:
			rgba(255,255,255,0.72);
	}


	.scroll-hint {
		display: block;

		margin: -44px 0 44px;

		text-align: center;

		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			sans-serif;

		font-size: 0.8rem;

		color:
			rgba(255,255,255,0.45);
	}



	/* =========================
	   时间轴
	   ========================= */

	.photo-timeline {
		position: relative;

		overflow-x: auto;
		overflow-y: hidden;

		padding:
			0 4px 26px;

		outline: none;

		cursor: grab;

		scrollbar-width: thin;
		scrollbar-color:
			rgba(255,255,255,0.30)
			transparent;
	}

	.photo-timeline:active {
		cursor: grabbing;
	}


	.photo-timeline::-webkit-scrollbar {
		height: 5px;
	}

	.photo-timeline::-webkit-scrollbar-track {
		background: transparent;
	}

	.photo-timeline::-webkit-scrollbar-thumb {
		background:
			rgba(255,255,255,0.30);

		border-radius: 3px;
	}


	/* 贯穿所有节点的横线 */

	.timeline-line {
		position: absolute;

		left: 4px;
		right: 4px;
		top: 34px;

		height: 1px;

		background:
			linear-gradient(
				to right,
				transparent,
				rgba(255,255,255,0.35) 6%,
				rgba(255,255,255,0.35) 94%,
				transparent
			);

		pointer-events: none;
	}


	.timeline-track {
		display: flex;

		gap: 34px;

		width: max-content;

		padding-right: 34px;
	}



	/* 单个时间节点 */

	.timeline-item {
		display: flex;
		flex-direction: column;

		width: 340px;

		flex-shrink: 0;

		text-decoration: none;

		color: white;
	}


	.timeline-date {
		position: relative;

		z-index: 1;

		display: flex;
		align-items: center;

		gap: 10px;

		height: 68px;


		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			sans-serif;

		font-size: 1rem;
		font-weight: 600;

		letter-spacing: 0.5px;

		color:
			rgba(255,255,255,0.92);

		font-variant-numeric: tabular-nums;
	}


	.timeline-dot {
		width: 9px;
		height: 9px;

		flex-shrink: 0;

		border-radius: 50%;

		background: white;

		box-shadow:
			0 0 0 4px
			rgba(255,255,255,0.18);

		transition:
			box-shadow 0.25s ease;
	}


	.timeline-item:hover
	.timeline-dot {
		box-shadow:
			0 0 0 6px
			rgba(255,255,255,0.28);
	}



	/* =========================
	   封面卡片
	   ========================= */

	.photo-card {
		position: relative;

		height: 420px;

		overflow: hidden;

		border-radius: 12px;

		box-shadow:
			0 15px 50px
				rgba(0,0,0,0.10);

		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}


	.timeline-item:hover
	.photo-card {
		transform:
			translateY(-5px);

		box-shadow:
			0 22px 55px
				rgba(0,0,0,0.18);
	}


	.photo-card img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		transition:
			transform 0.8s ease;
	}


	.timeline-item:hover
	.photo-card img {
		transform:
			scale(1.03);
	}


	/* 底部轻微渐变，只负责文字可读性 */

	.photo-gradient {
		position: absolute;
		inset: 0;

		background:
			linear-gradient(
				to bottom,
				transparent 58%,
				rgba(0,0,0,0.42) 100%
			);

		pointer-events: none;
	}



	/* =========================
	   左下角：名称 + 日期地点
	   ========================= */

	.photo-caption {
		position: absolute;

		left: 26px;
		right: 26px;
		bottom: 24px;

		z-index: 2;
	}


	.photo-caption h3 {
		margin: 0;

		color: white;
		font-size: 1.3rem;
		font-weight: 400;

		letter-spacing: 1px;
	}


	.photo-caption p {
		margin:
			7px 0 0;

		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			sans-serif;

		font-size: 0.82rem;

		color:
			rgba(255,255,255,0.72);
	}



	/* =========================
	   View Works
	   ========================= */

	.photo-more {
		display: block;

		width: fit-content;

		margin:
			32px auto 0;

		color:
			rgba(255,255,255,0.86);

		text-decoration: none;

		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}


	.photo-more:hover {
		opacity: 0.6;

		transform:
			translateX(3px);
	}



	@media(max-width: 700px) {

		.recent-photos {
			padding:
				100px 20px;
		}


		.scroll-hint {
			margin: -36px 0 36px;
		}


		.timeline-item {
			width: 270px;
		}


		.photo-card {
			height: 340px;
		}


		.photo-caption {
			left: 20px;
			right: 20px;
			bottom: 20px;
		}


		.photo-caption h3 {
			font-size: 1.15rem;
		}

	}

</style>


<script>

	const timelines =
		document.querySelectorAll(
			'[data-photo-timeline]'
		);


	timelines.forEach((timeline) => {

		if (!(timeline instanceof HTMLElement)) {
			return;
		}


		// 滚轮：纵向滚动映射为横向滑动
		timeline.addEventListener(
			'wheel',
			(event) => {

				if (
					Math.abs(event.deltaY) < 10 &&
					Math.abs(event.deltaX) < 10
				) {
					return;
				}


				const delta =
					Math.abs(event.deltaY) >=
					Math.abs(event.deltaX)
						? event.deltaY
						: event.deltaX;


				const maxScroll =
					timeline.scrollWidth -
					timeline.clientWidth;


				if (maxScroll <= 0) {
					return;
				}


				const atStart =
					timeline.scrollLeft <= 0;


				const atEnd =
					timeline.scrollLeft >= maxScroll - 1;


				// 在边界时不拦截页面纵向滚动
				if (
					(delta < 0 && atStart) ||
					(delta > 0 && atEnd)
				) {
					return;
				}


				event.preventDefault();

				timeline.scrollLeft += delta;

			},
			{
				passive: false
			}
		);


		// 拖拽滑动
		let dragging = false;

		let startX = 0;

		let startLeft = 0;


		timeline.addEventListener('pointerdown', (event) => {

			if (event.pointerType === 'touch') {
				return;
			}


			dragging = true;

			startX = event.clientX;

			startLeft = timeline.scrollLeft;

		});


		timeline.addEventListener('pointermove', (event) => {

			if (!dragging) {
				return;
			}


			timeline.scrollLeft =
				startLeft -
				(event.clientX - startX);

		});


		const endDrag = () => {
			dragging = false;
		};


		timeline.addEventListener('pointerup', endDrag);
		timeline.addEventListener('pointerleave', endDrag);


		// 拖拽时不要误触发链接跳转
		timeline.addEventListener('click', (event) => {

			if (
				Math.abs(
					(event as MouseEvent).clientX - startX
				) > 6
			) {
				event.preventDefault();
			}

		});

	});

</script>
