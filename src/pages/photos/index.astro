---
import BaseHead from '../../components/BaseHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import photosData from '../../data/photos.json';
import { buildPhotoTimeline } from '../../data/photo-timeline.mjs';
import PhotoTimelineRings from '../../components/PhotoTimelineRings.astro';
import sharp from 'sharp';
import { fileURLToPath } from 'node:url';

const timeline = buildPhotoTimeline(photosData);
const entries = timeline.flatMap(year => year.entries);
const photos = entries.flatMap(entry => entry.items);
// Reserve each image's actual aspect ratio so lazy loading cannot move date
// anchors or change the active photo after a jump down the stream.
const dimensions = new Map(await Promise.all(photos.map(async photo => {
	if (!photo.image.startsWith('/images/') || photo.image.includes('..')) return [photo.id, null] as const;
	const file = fileURLToPath(new URL(`../../../public${photo.image}`, import.meta.url));
	const { width, height } = await sharp(file).metadata();
	return [photo.id, { width, height }] as const;
})));
---

<!doctype html>
<html lang="zh-CN">

<head>
	<link rel="stylesheet" href="/fonts/noto-serif-sc.css">

	<BaseHead
		title={`摄影 | ${SITE_TITLE}`}
		description={SITE_DESCRIPTION}
	/>

	<style>
		:global(html) {
			background: #111;
			scroll-behavior: smooth;
		}

		:global(body) {
			margin: 0;
			padding: 0;
			font-family: "Noto Serif SC", serif;
		}

		.background {
			position: fixed;
			inset: -24px;
			background-image: url("/images/home/hero.webp");
			background-size: cover;
			background-position: center;
			filter: blur(10px) brightness(0.72);
			transform: scale(1.03);
			z-index: 0;
		}

		.page-title .epigraph {
		margin: 0.5em 0 0;
		}

		.epigraph-text {
		font-family: Georgia, "Noto Serif SC", serif;
		font-style: italic;
		font-size: 1.05em;
		color: white;
		}


		.background::after {
			content: "";
			position: absolute;
			inset: 0;
			background: rgba(18, 27, 35, 0.16);
		}

		main {
			position: relative;
			z-index: 1;
			width: 100%;
			max-width: none;
			margin: 0;
			padding: 0;
		}

		.page-title {
			max-width: 1450px;
			margin: 65px auto 90px;
			padding: 0 35px;
			color: white;
		}

		.page-title h1 {
			margin: 0;
			font-size: clamp(2.8rem, 6vw, 5rem);
			font-weight: 300;
			letter-spacing: 8px;
			color: white;
			font-family: "Noto Serif SC", serif;;
		}

		.page-title p {
			margin: 18px 0 0;
			color: rgba(255,255,255,0.65);
			font-style: italic;
		}

		.photo-layout {
			max-width: 1450px;
			margin: 0 auto;
			padding: 0 35px 140px;
			display: grid;
			grid-template-columns: 190px minmax(0, 1fr) 280px;
			gap: 40px;
			align-items: start;
		}
		.photo-layout.is-empty { display: block; }
		.photo-layout.is-empty .photo-info { display: none; }

		.photo-info {
			position: sticky;
			top: 90px;
			height: fit-content;
		}

		.photo-stream,
		.entry-photos {
			display: flex;
			flex-direction: column;
			gap: 120px;
		}

		.photo-entry, .photo-item { scroll-margin-top: 70px; }
		/* Hairline between day runs; negative margins keep the photo rhythm. */
		.day-break {
			height: 1px;
			background: rgba(255,255,255,.15);
			margin-block: -59px;
		}
		.empty-state { color: rgba(255,255,255,.7); }
		.photo-info [hidden] { display: none; }

		.photo-item {
			scroll-margin-top: 70px;
		}

		.photo-frame {
			position: relative;
			width: 100%;
			background: rgba(255,255,255,0.06);
			border: 1px solid rgba(255,255,255,0.12);
			border-radius: 14px;
			overflow: hidden;
			box-shadow: 0 18px 60px rgba(0,0,0,0.18);
		}

		@media (min-width: 761px) {
			.photo-frame {
				--photo-max-h: min(78vh, 880px);
				width: min(100%, calc(var(--photo-max-h) * var(--photo-ratio, 999)));
				margin-inline: auto;
			}

			/* JS sets --info-shift to the gap a centered portrait leaves on its
			   right side; the panel slides left by that amount and widens so its
			   right edge stays in the original column. */
			.photo-info {
				margin-left: calc(var(--info-shift, 0px) * -1);
				width: calc(100% + var(--info-shift, 0px));
				transition: margin-left .22s ease, width .22s ease;
			}
		}

		@media (prefers-reduced-motion: reduce) and (min-width: 761px) {
			.photo-info {
				transition: none;
			}
		}

		.photo-frame img {
			display: block;
			width: 100%;
			height: auto;
			object-fit: contain;
		}

		/* MM.DD on the first photo of each day run. */
		.photo-day-tag {
			position: absolute;
			top: 12px;
			left: 12px;
			z-index: 1;
			padding: 3px 10px;
			border-radius: 999px;
			background: rgba(17, 24, 30, 0.45);
			border: 1px solid rgba(255,255,255,0.18);
			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);
			color: rgba(255,255,255,0.9);
			font: 11px/1.4 "Noto Serif SC", serif;
			letter-spacing: 1px;
			font-variant-numeric: tabular-nums;
		}

		.mobile-info {
			display: none;
		}

		.photo-info {
			padding: 24px 0;
			color: white;
		}

		.photo-info h2 {
			margin: 0;
			font-size: 1.8rem;
			font-weight: 400;
			line-height: 1.45;
			color: white;
		}

		.photo-date {
			margin-top: 12px;
			font-size: 0.86rem;
			color: rgba(255,255,255,0.55);
		}

		.photo-camera {
			margin-top: 18px;
			font-family: "Noto Serif SC", serif;
			font-size: 0.82rem;
			color: rgba(255,255,255,0.48);
		}

		/* Second EXIF line sits close under the first; typography unchanged. */
		.photo-camera + .photo-camera {
			margin-top: 4px;
		}

		.photo-note {
			margin-top: 32px;
			font-size: 1rem;
			line-height: 2;
			color: rgba(255,255,255,0.78);
			white-space: pre-line;
		}

		.footer {
			position: relative;
			z-index: 2;
			padding: 30px 20px 40px;
			text-align: center;
			color: rgba(255,255,255,0.55);
			font-size: 0.85rem;
		}

		@media (max-width: 1050px) {
			.photo-layout {
				grid-template-columns: 150px minmax(0, 1fr) 210px;
				gap: 24px;
			}
		}

		@media (max-width: 760px) {
			.page-title {
				margin: 45px auto 60px;
				padding: 0 20px;
			}

			.photo-layout {
				display: block;
				padding: 0 20px 90px;
			}

			.photo-info {
				display: none;
			}

			.photo-stream,
			.entry-photos {
				gap: 75px;
			}

			.day-break {
				margin-block: -37px;
			}

			.mobile-info {
				display: block;
				padding: 18px 2px 0;
				color: white;
			}

			.mobile-info h2 {
				margin: 0;
				font-size: 1.5rem;
				font-weight: 400;
				color: white;
			}

			.mobile-meta {
				margin-top: 8px;
				font-size: 0.84rem;
				color: rgba(255,255,255,0.55);
			}

			.mobile-note {
				margin-top: 18px;
				line-height: 1.9;
				white-space: pre-line;
				color: rgba(255,255,255,0.76);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			:global(html) { scroll-behavior: auto; }
		}
	</style>
</head>

<body>

<div class="background"></div>

<main>

	<SiteNav active="photos" />

	<header class="page-title">
	<h1>摄影</h1>
	<p class="epigraph">
		<span class="epigraph-text">Because it is there.</span>
	</p>
	</header>

	<div class:list={['photo-layout', { 'is-empty': !photos.length }]}>

		{photos.length > 0 && <PhotoTimelineRings timeline={timeline} />}

		<section class="photo-stream" aria-label="摄影作品">
			{!photos.length && <p class="empty-state">还没有公开的摄影作品。</p>}
			{entries.map((entry, entryIndex) => (
			<section class="photo-entry" id={entry.id} aria-labelledby={`${entry.id}-heading`}>
				<h2 class="sr-only" id={`${entry.id}-heading`}>{entry.label}</h2>
				<div class="entry-photos">

			{entry.items.map((photo, index) => {
				const dims = dimensions.get(photo.id);
				const ratio = dims?.width && dims?.height ? (dims.width / dims.height).toFixed(6) : undefined;
				return (

				<Fragment>
					{photo.dayStart && (entryIndex > 0 || index > 0) && (
						<div class="day-break" aria-hidden="true"></div>
					)}
					<article
						id={photo.id}
						class="photo-item"
						data-photo={JSON.stringify(photo)}
						data-entry={entry.key}
						data-entry-position={index + 1}
					>

						<div class="photo-frame" style={ratio ? `--photo-ratio: ${ratio}` : undefined}>
							{photo.dayStart && photo.day && (
								<span class="photo-day-tag">{photo.day.slice(5).replace('-', '.')}</span>
							)}
							<img
								src={photo.image}
								alt={photo.alt}
								width={dimensions.get(photo.id)?.width}
								height={dimensions.get(photo.id)?.height}
								loading={photo === photos[0] ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</div>

						<div class="mobile-info">
							{photo.title && <h2>{photo.title}</h2>}

							<div class="mobile-meta">
								{[photo.time, photo.location].filter(Boolean).join(' · ')}
								{photo.equip && <div>{photo.equip}</div>}
								{photo.exposure && <div>{photo.exposure}</div>}
							</div>

							{photo.note && <p class="mobile-note">
								{photo.note}
							</p>}
						</div>

					</article>
				</Fragment>

				);
			})}

				</div>
			</section>
			))}
		</section>

		<aside class="photo-info" aria-label="当前照片信息">
			<h2 id="info-title" hidden={!photos[0]?.title}>{photos[0]?.title}</h2>
			<div class="photo-date" id="info-date">{[photos[0]?.time, photos[0]?.location].filter(Boolean).join(' · ')}</div>
			<div class="photo-camera" id="info-equip">{photos[0]?.equip}</div>
			<div class="photo-camera" id="info-exposure">{photos[0]?.exposure}</div>
			<p class="photo-note" id="info-note" hidden={!photos[0]?.note}>{photos[0]?.note}</p>
		</aside>

	</div>

</main>

<footer class="footer">
	© 2026 AndRainWindow
	{photos.some(photo => photo.locationSource === 'geoapify') && <span> · 地点数据：<a href="https://www.geoapify.com/">Geoapify</a> / <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a></span>}
	{photos.some(photo => photo.locationSource === 'amap') && <span> · 地点数据：<a href="https://www.amap.com/">高德地图</a></span>}
</footer>

<script>
	const items = [...document.querySelectorAll<HTMLElement>('.photo-item')];
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.timeline-link')];
	const yearSelect = document.querySelector<HTMLSelectElement>('[data-timeline-year]');
	const entrySelect = document.querySelector<HTMLSelectElement>('[data-timeline-entry]');
	const dial = document.querySelector<HTMLElement>('.date-dial');
	const position = document.querySelector('[data-timeline-position]');
	const archive = document.querySelector<HTMLElement>('.archive-scroll');
	const layout = document.querySelector<HTMLElement>('.photo-layout');
	const info = document.querySelector<HTMLElement>('.photo-info');
	const years = [...new Set(links.map(link => link.dataset.year))];
	const title = document.querySelector('#info-title');
	const date = document.querySelector('#info-date');
	const equip = document.querySelector('#info-equip');
	const exposure = document.querySelector('#info-exposure');
	const note = document.querySelector('#info-note');
	let active: HTMLElement | undefined;
	let activeYear: string | undefined;

	// Keep the info panel beside whichever photo is active: centered portraits
	// leave a gap on the right side of the stream column, so slide the panel
	// into it and widen it by the same amount.
	function syncInfoPlacement(item: HTMLElement) {
		if (!layout || !info) return;
		if (!matchMedia('(min-width: 761px)').matches) {
			layout.style.removeProperty('--info-shift');
			return;
		}
		const frame = item.querySelector('.photo-frame');
		if (!frame) return;
		const shift = Math.max(0, Math.round(item.getBoundingClientRect().right - frame.getBoundingClientRect().right));
		layout.style.setProperty('--info-shift', `${shift}px`);
	}

	function setActive(item: HTMLElement) {
		if (active === item) return;
		active = item;
		const photo = JSON.parse(item.dataset.photo || '{}');
		if (title) { title.textContent = photo.title || ''; title.toggleAttribute('hidden', !photo.title); }
		if (date) date.textContent = [photo.time, photo.location].filter(Boolean).join(' · ');
		if (equip) equip.textContent = photo.equip || '';
		if (exposure) exposure.textContent = photo.exposure || '';
		if (note) { note.textContent = photo.note || ''; note.toggleAttribute('hidden', !photo.note); }
		syncInfoPlacement(item);

		const entryKey = item.dataset.entry;
		const link = links.find(link => link.dataset.entry === entryKey);
		if (!link) return;
		const year = link.dataset.year || 'undated';
		const yearLinks = links.filter(link => link.dataset.year === year);
		if (yearSelect) yearSelect.value = year;
		if (entrySelect) {
			if (activeYear !== year) {
				entrySelect.replaceChildren(...yearLinks.map(link => new Option(
					link.dataset.day === 'undated' ? '—' : link.dataset.day!.slice(5).replace('-', '.'), link.dataset.entry
				)));
			}
			entrySelect.value = entryKey!;
		}
		activeYear = year;
		dial?.style.setProperty('--year-progress', String((years.indexOf(year) + 1) / years.length * 100));
		dial?.style.setProperty('--day-progress', String((yearLinks.indexOf(link) + 1) / yearLinks.length * 100));
		if (position) {
			position.textContent = `${String(item.dataset.entryPosition).padStart(2, '0')} / ${String(link.dataset.count).padStart(2, '0')}`;
			position.setAttribute('aria-label', `本组第 ${item.dataset.entryPosition} 张，共 ${link.dataset.count} 张`);
		}
		links.forEach(candidate => {
			candidate.classList.toggle('active', candidate === link);
			if (candidate === link) candidate.setAttribute('aria-current', 'true');
			else candidate.removeAttribute('aria-current');
		});
		// Keep the highlighted entry inside its own list without moving the page.
		if (archive) {
			const bounds = archive.getBoundingClientRect();
			const current = link.getBoundingClientRect();
			if (current.top < bounds.top) archive.scrollTop += current.top - bounds.top;
			else if (current.bottom > bounds.bottom) archive.scrollTop += current.bottom - bounds.bottom;
		}
	}

	function selectHash() {
		let target: HTMLElement | null = null;
		try { target = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { return; }
		const item = target?.matches('.photo-item') ? target : target?.querySelector<HTMLElement>('.photo-item');
		if (item) setActive(item);
	}

	function updateFromScroll() {
		if (!items.length) return;
		// Select by reading position, not intersection ratio (which fails on tall
		// portraits and can leave stale metadata when several entries cross at once).
		const anchor = Math.min(innerHeight * .34, 260);
		let low = 0, high = items.length - 1;
		while (low < high) {
			const mid = Math.ceil((low + high) / 2);
			if (items[mid].getBoundingClientRect().top <= anchor) low = mid;
			else high = mid - 1;
		}
		const atEnd = scrollY > 0 && innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
		setActive(items[atEnd ? items.length - 1 : low]);
	}
	let scheduled = false;
	function scheduleUpdate() {
		if (scheduled) return;
		scheduled = true;
		requestAnimationFrame(() => {
			scheduled = false;
			updateFromScroll();
			if (active) syncInfoPlacement(active);
		});
	}

	if (items.length) {
		setActive(items[0]);
		selectHash();
		if (yearSelect) {
			yearSelect.disabled = false;
			yearSelect.addEventListener('change', () => links.find(link => link.dataset.year === yearSelect.value)?.click());
		}
		if (entrySelect) {
			entrySelect.disabled = false;
			entrySelect.addEventListener('change', () => links.find(link => link.dataset.entry === entrySelect.value)?.click());
		}
		window.addEventListener('scroll', scheduleUpdate, { passive: true });
		window.addEventListener('resize', scheduleUpdate);
		window.addEventListener('pageshow', scheduleUpdate);
		window.addEventListener('hashchange', () => { selectHash(); scheduleUpdate(); });
		items.forEach(item => item.querySelector('img')?.addEventListener('load', scheduleUpdate));
		scheduleUpdate();
	}
</script>

</body>
</html>
